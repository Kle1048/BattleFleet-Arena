{
  "name": "@battlefleet/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bfa-source": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./rules": {
      "types": "./src/rules/index.ts",
      "bfa-source": "./src/rules/index.ts",
      "node": "./dist/rules/index.js",
      "default": "./src/rules/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "bfa-source": "./src/protocol/index.ts",
      "node": "./dist/protocol/index.js",
      "default": "./src/protocol/index.ts"
    },
    "./protocol/schema": {
      "types": "./src/protocol/schema.ts",
      "bfa-source": "./src/protocol/schema.ts",
      "node": "./dist/protocol/schema.js",
      "default": "./src/protocol/schema.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/rules/index.ts src/protocol/index.ts src/protocol/schema.ts --bundle --splitting --packages=external --platform=node --format=esm --outbase=src --outdir=dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/run-tests.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.37"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3"
  }
}
